 <body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">
 
     <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f4f4; padding: 20px;">
         <tr>
             <td align="center">
                 <table role="presentation" width="600px" cellspacing="0" cellpadding="0" border="0" style="background: white; border-radius: 10px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);">
                     <!-- Encabezado con logo -->
                     <tr>
                         <td align="center" style="background-color: black; padding: 15px;">
                             <img src="https://cimal.com.mx/wp-content/uploads/2024/12/CLAYENS-Group-2022.png" alt="Clayens México" width="190" height="50">
                         </td>
                     </tr>
                     <!-- Contenido principal -->
                     <tr>
                         <td style="padding: 20px; text-align: center;">
                             <h1 style="color: #333; font-style: italic;">Reporte de Soporte Recursos Humanos Recibido</h1>
                             <p style="color: #555; font-size: 16px;">
                                 Hemos recibido un nuevo reporte de Soporte Recursos Humanos. Por favor, accede a Kiosko Clayens para más detalles.
                             </p>
                             <!-- Botón de acción -->
                             <a href="http://10.99.22.17:8080/login" target="_blank" 
                                style="display: inline-block; padding: 12px 24px; margin-top: 20px; background-color: #007BFF; 
                                       color: white; text-decoration: none; font-size: 16px; border-radius: 5px;">
                                 Acceder a Kiosko Clayens
                             </a>
                         </td>
